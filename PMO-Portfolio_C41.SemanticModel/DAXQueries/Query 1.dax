// Welcome to DAX query view! Learn more about DAX queries at https://aka.ms/dax-queries.
// Right-click on tables, columns, or measures in the data pane to access quick queries, or ask Copilot for help writing DAX.
-- PMO_C41_measures.dax  -- FP20 Challenge 41
-- HOW TO USE: (1) Home > Enter data: make a table named _Measures with one column (Col1), Load, then hide Col1.
--             (2) Left rail > DAX query view, paste this whole file, click "Update model with changes" (top of the editor).
--             (3) Run after the calculated columns are in (these measures reference FactProjectMonthly[Earned Value Row EUR] and [Is Final Snapshot]).
-- Formats: set in Measure tools afterwards (SPI/CPI 0.000, % 0.0%, EUR  €#,0.0,,"M").

DEFINE
-- ===== 4.4 Month-context measures =====
MEASURE _Measures[Projects Reporting] = DISTINCTCOUNT ( FactProjectMonthly[ProjectKey] )
MEASURE _Measures[Planned Value EUR] = SUM ( FactProjectMonthly[PlannedCostToDateEUR] )
MEASURE _Measures[Earned Value EUR] = SUM ( FactProjectMonthly[Earned Value Row EUR] )
MEASURE _Measures[Actual Cost EUR] = SUM ( FactProjectMonthly[ActualCostToDateEUR] )
MEASURE _Measures[SPI] = DIVIDE ( [Earned Value EUR], [Planned Value EUR] )
MEASURE _Measures[CPI] = DIVIDE ( [Earned Value EUR], [Actual Cost EUR] )
-- Source ScheduleVarianceEUR = PV - EV (opposite sign to CostVarianceEUR). Recomputed so positive = ahead.
MEASURE _Measures[Schedule Variance EUR] = [Earned Value EUR] - [Planned Value EUR]
MEASURE _Measures[Cost Variance EUR] = SUM ( FactProjectMonthly[CostVarianceEUR] )
MEASURE _Measures[Avg Health] = AVERAGE ( FactProjectMonthly[PortfolioHealthScore] )
MEASURE _Measures[Forecast Overrun EUR] =
    SUM ( FactProjectMonthly[ForecastTotalCostEUR] ) - SUM ( FactProjectMonthly[BaselineBudgetEUR] )
MEASURE _Measures[Forecast Overrun %] =
    DIVIDE ( [Forecast Overrun EUR], SUM ( FactProjectMonthly[BaselineBudgetEUR] ) )
MEASURE _Measures[Benefit Outlook %] =
    DIVIDE ( SUM ( FactProjectMonthly[ForecastBenefitEUR] ), SUM ( FactProjectMonthly[PlannedBenefitEUR] ) ) - 1
MEASURE _Measures[Capacity Gap %] =
    DIVIDE (
        SUM ( FactProjectMonthly[AvailableResourceHours] ) - SUM ( FactProjectMonthly[PlannedResourceHours] ),
        SUM ( FactProjectMonthly[PlannedResourceHours] )
    )
MEASURE _Measures[Benefit Realisation %] =
    DIVIDE ( SUM ( FactProjectMonthly[RealisedBenefitToDateEUR] ), SUM ( FactProjectMonthly[PlannedBenefitToDateEUR] ) )
MEASURE _Measures[Milestone On-Time %] =
    DIVIDE ( SUM ( FactProjectMonthly[MilestonesCompletedOnTime] ), SUM ( FactProjectMonthly[MilestonesDue] ) )

-- ===== 4.5 "As of" measures (period-end value at Year/Quarter, that month at Month level) =====
MEASURE _Measures[Projects (as of)] =
    VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
    RETURN CALCULATE ( [Projects Reporting], FactProjectMonthly[ReportingDateKey] = m )
MEASURE _Measures[SPI (as of)] =
    VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
    RETURN CALCULATE ( [SPI], FactProjectMonthly[ReportingDateKey] = m )
MEASURE _Measures[CPI (as of)] =
    VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
    RETURN CALCULATE ( [CPI], FactProjectMonthly[ReportingDateKey] = m )
MEASURE _Measures[Avg Health (as of)] =
    VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
    RETURN CALCULATE ( [Avg Health], FactProjectMonthly[ReportingDateKey] = m )
MEASURE _Measures[Forecast Overrun EUR (as of)] =
    VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
    RETURN CALCULATE ( [Forecast Overrun EUR], FactProjectMonthly[ReportingDateKey] = m )
MEASURE _Measures[Forecast Overrun % (as of)] =
    VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
    RETURN CALCULATE ( [Forecast Overrun %], FactProjectMonthly[ReportingDateKey] = m )
MEASURE _Measures[Benefit Outlook % (as of)] =
    VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
    RETURN CALCULATE ( [Benefit Outlook %], FactProjectMonthly[ReportingDateKey] = m )
MEASURE _Measures[Capacity Gap % (as of)] =
    VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
    RETURN CALCULATE ( [Capacity Gap %], FactProjectMonthly[ReportingDateKey] = m )

-- ===== 4.6 "Final position" measures (page 2; ignore the date slicer) =====
MEASURE _Measures[Projects (final)] =
    CALCULATE ( DISTINCTCOUNT ( FactProjectMonthly[ProjectKey] ), REMOVEFILTERS ( DimDate ) )
MEASURE _Measures[Baseline Budget (final)] =
    CALCULATE ( SUM ( FactProjectMonthly[BaselineBudgetEUR] ), FactProjectMonthly[Is Final Snapshot] = 1, REMOVEFILTERS ( DimDate ) )
MEASURE _Measures[Forecast Cost (final)] =
    CALCULATE ( SUM ( FactProjectMonthly[ForecastTotalCostEUR] ), FactProjectMonthly[Is Final Snapshot] = 1, REMOVEFILTERS ( DimDate ) )
MEASURE _Measures[Actual Cost (final)] =
    CALCULATE ( SUM ( FactProjectMonthly[ActualCostToDateEUR] ), FactProjectMonthly[Is Final Snapshot] = 1, REMOVEFILTERS ( DimDate ) )
MEASURE _Measures[Forecast Benefit (final)] =
    CALCULATE ( SUM ( FactProjectMonthly[ForecastBenefitEUR] ), FactProjectMonthly[Is Final Snapshot] = 1, REMOVEFILTERS ( DimDate ) )
MEASURE _Measures[Planned Benefit (final)] =
    CALCULATE ( SUM ( FactProjectMonthly[PlannedBenefitEUR] ), FactProjectMonthly[Is Final Snapshot] = 1, REMOVEFILTERS ( DimDate ) )
MEASURE _Measures[Remaining Spend (final)] = [Forecast Cost (final)] - [Actual Cost (final)]
MEASURE _Measures[Overrun % (final)] = DIVIDE ( [Forecast Cost (final)], [Baseline Budget (final)] ) - 1
MEASURE _Measures[Benefit Outlook % (final)] = DIVIDE ( [Forecast Benefit (final)], [Planned Benefit (final)] ) - 1
MEASURE _Measures[BCR (final)] = DIVIDE ( [Forecast Benefit (final)], [Forecast Cost (final)] )

EVALUATE ROW ( "Measures defined", 1 )
