table _Measures
	lineageTag: 8e7c2c1f-1e8f-43c5-af14-0ca74c8d318b

	measure 'Projects Reporting' = DISTINCTCOUNT ( FactProjectMonthly[ProjectKey] )
		formatString: 0
		lineageTag: 6baec677-cd04-4761-85a5-97be17c1da35

	measure 'Planned Value EUR' = SUM ( FactProjectMonthly[PlannedCostToDateEUR] )
		formatString: €#,0.0,,"M"
		lineageTag: 9fcc9060-b1d0-4c2a-8c94-92f7399b0353

	measure 'Earned Value EUR' = SUM ( FactProjectMonthly[Earned Value Row EUR] )
		formatString: €#,0.0,,"M"
		lineageTag: 9ed1bc18-acb3-4ffe-95d3-169d095c5082

	measure 'Actual Cost EUR' = SUM ( FactProjectMonthly[ActualCostToDateEUR] )
		formatString: €#,0.0,,"M"
		lineageTag: 29aef979-a6b5-46b3-8ab8-b2d6c6e095d8

	measure SPI = DIVIDE ( [Earned Value EUR], [Planned Value EUR] )
		formatString: 0.000
		lineageTag: 02949b42-9c0a-43ae-8dad-10dda7ba770f

	measure CPI = DIVIDE ( [Earned Value EUR], [Actual Cost EUR] )
		formatString: 0.000
		lineageTag: ddccdc8c-1d00-45d4-a1c8-f3bb13b2e64c

	measure 'Schedule Variance EUR' = [Earned Value EUR] - [Planned Value EUR]
		formatString: €#,0.0,,"M"
		lineageTag: 371b0d2a-9b3b-40e5-b259-4464ce43c64d

	measure 'Cost Variance EUR' = SUM ( FactProjectMonthly[CostVarianceEUR] )
		formatString: €#,0.0,,"M"
		lineageTag: 5ed3ebfb-9b20-4296-9c45-be14ade0166d

	measure 'Avg Health' = AVERAGE ( FactProjectMonthly[PortfolioHealthScore] )
		formatString: 0.0
		lineageTag: d2de0245-b97f-4060-96df-9616357b5189

	measure 'Forecast Overrun EUR' = SUM ( FactProjectMonthly[ForecastTotalCostEUR] ) - SUM ( FactProjectMonthly[BaselineBudgetEUR] )
		formatString: €#,0.0,,"M"
		lineageTag: 6efe9d9c-c788-497e-bf13-34fcc32996f0

	measure 'Forecast Overrun %' = DIVIDE ( [Forecast Overrun EUR], SUM ( FactProjectMonthly[BaselineBudgetEUR] ) )
		formatString: 0.0%
		lineageTag: fea065b0-3e00-4aa8-86a0-68d3949ce1f0

	measure 'Benefit Outlook %' = DIVIDE ( SUM ( FactProjectMonthly[ForecastBenefitEUR] ), SUM ( FactProjectMonthly[PlannedBenefitEUR] ) ) - 1
		formatString: 0.0%
		lineageTag: f8b35498-4a85-418a-8271-a0755fe7f9ae

	measure 'Capacity Gap %' =
			DIVIDE (
			        SUM ( FactProjectMonthly[AvailableResourceHours] ) - SUM ( FactProjectMonthly[PlannedResourceHours] ),
			        SUM ( FactProjectMonthly[PlannedResourceHours] )
			    )
		formatString: 0.0%
		lineageTag: 27850f40-2c53-4a0b-b057-537e44530793

	measure 'Benefit Realisation %' = DIVIDE ( SUM ( FactProjectMonthly[RealisedBenefitToDateEUR] ), SUM ( FactProjectMonthly[PlannedBenefitToDateEUR] ) )
		formatString: 0.0%
		lineageTag: 0d78dcc4-7ed5-4b6b-b37a-6383b8f57c28

	measure 'Milestone On-Time %' = DIVIDE ( SUM ( FactProjectMonthly[MilestonesCompletedOnTime] ), SUM ( FactProjectMonthly[MilestonesDue] ) )
		formatString: 0.0%
		lineageTag: 1f22ed52-096b-42df-acff-e598a12e3ca2

	measure 'Projects (as of)' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			    RETURN CALCULATE ( [Projects Reporting], FactProjectMonthly[ReportingDateKey] = m )
		formatString: 0
		lineageTag: 7065ca02-4caf-470d-ab1e-b5b7783a2a1b

	measure 'SPI (as of)' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			    RETURN CALCULATE ( [SPI], FactProjectMonthly[ReportingDateKey] = m )
		formatString: 0.000
		lineageTag: 0bd68dd0-0645-4448-ad00-ade47845fd77

	measure 'CPI (as of)' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			    RETURN CALCULATE ( [CPI], FactProjectMonthly[ReportingDateKey] = m )
		formatString: 0.000
		lineageTag: 6e2c0da4-7815-457c-ba7a-5d59c9a47404

	measure 'Avg Health (as of)' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			    RETURN CALCULATE ( [Avg Health], FactProjectMonthly[ReportingDateKey] = m )
		formatString: 0.0
		lineageTag: 5b4abe98-62e3-4445-9008-8ef23f3bb69b

	measure 'Forecast Overrun EUR (as of)' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			    RETURN CALCULATE ( [Forecast Overrun EUR], FactProjectMonthly[ReportingDateKey] = m )
		formatString: €#,0.0,,"M"
		lineageTag: 9e8d4d0b-77ba-41f3-a146-424bf20bcb8b

	measure 'Forecast Overrun % (as of)' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			    RETURN CALCULATE ( [Forecast Overrun %], FactProjectMonthly[ReportingDateKey] = m )
		formatString: 0.0%
		lineageTag: 317d351a-f841-4f32-b35c-df1acde46d01

	measure 'Benefit Outlook % (as of)' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			    RETURN CALCULATE ( [Benefit Outlook %], FactProjectMonthly[ReportingDateKey] = m )
		formatString: 0.0%
		lineageTag: 0887460c-f534-4a93-97ed-347b7f3d564d

	measure 'Capacity Gap % (as of)' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			    RETURN CALCULATE ( [Capacity Gap %], FactProjectMonthly[ReportingDateKey] = m )
		formatString: 0.0%
		lineageTag: 4e456fb0-d2af-4945-a222-a8a8d94518a2

	measure 'Projects (final)' = CALCULATE ( DISTINCTCOUNT ( FactProjectMonthly[ProjectKey] ), REMOVEFILTERS ( DimDate ) )
		formatString: 0
		lineageTag: d6662c94-9935-4be7-b607-5390cb1f0c9d

	measure 'Baseline Budget (final)' = CALCULATE ( SUM ( FactProjectMonthly[BaselineBudgetEUR] ), FactProjectMonthly[Is Final Snapshot] = 1, REMOVEFILTERS ( DimDate ) )
		formatString: €#,0.0,,"M"
		lineageTag: 78a2d542-6c79-44ff-9248-dcc2c5ce2433

	measure 'Forecast Cost (final)' = CALCULATE ( SUM ( FactProjectMonthly[ForecastTotalCostEUR] ), FactProjectMonthly[Is Final Snapshot] = 1, REMOVEFILTERS ( DimDate ) )
		formatString: €#,0.0,,"M"
		lineageTag: f5040d18-f067-47b6-b883-bc836ee7435f

	measure 'Actual Cost (final)' = CALCULATE ( SUM ( FactProjectMonthly[ActualCostToDateEUR] ), FactProjectMonthly[Is Final Snapshot] = 1, REMOVEFILTERS ( DimDate ) )
		formatString: €#,0.0,,"M"
		lineageTag: c1021dd1-78c6-42be-9de0-0ac9fb3933ce

	measure 'Forecast Benefit (final)' = CALCULATE ( SUM ( FactProjectMonthly[ForecastBenefitEUR] ), FactProjectMonthly[Is Final Snapshot] = 1, REMOVEFILTERS ( DimDate ) )
		formatString: €#,0.0,,"M"
		lineageTag: 48d61dc9-afd3-4a39-aa2e-8efccf1760f2

	measure 'Planned Benefit (final)' = CALCULATE ( SUM ( FactProjectMonthly[PlannedBenefitEUR] ), FactProjectMonthly[Is Final Snapshot] = 1, REMOVEFILTERS ( DimDate ) )
		formatString: €#,0.0,,"M"
		lineageTag: 056f9d78-b3b8-4407-a3b5-4112b1893a58

	measure 'Remaining Spend (final)' = [Forecast Cost (final)] - [Actual Cost (final)]
		formatString: €#,0.0,,"M"
		lineageTag: cb30e466-39c1-4d23-aaca-ad79931c7502

	measure 'Overrun % (final)' = DIVIDE ( [Forecast Cost (final)], [Baseline Budget (final)] ) - 1
		formatString: 0.0%
		lineageTag: fbadc94c-2fa4-49bb-a851-2b161fabafc0

	measure 'Benefit Outlook % (final)' = DIVIDE ( [Forecast Benefit (final)], [Planned Benefit (final)] ) - 1
		formatString: 0.0%
		lineageTag: 4edf4d94-e0a4-465a-932b-98af704d41d2

	measure 'BCR (final)' = DIVIDE ( [Forecast Benefit (final)], [Forecast Cost (final)] )
		formatString: 0.00
		lineageTag: 32bbeac2-3dc7-4e1e-bbf6-646101fab31b

	measure 'Parity (1.0)' = 1
		formatString: 0.0
		lineageTag: 5a1c0003-0000-4000-8000-000000000001

	measure 'Narr Context' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			VAR d = LOOKUPVALUE ( DimDate[Date], DimDate[DateKey], m )
			VAR n = CALCULATE ( [Projects Reporting], FactProjectMonthly[ReportingDateKey] = m )
			RETURN "As of " & FORMAT ( d, "mmm yyyy" ) & " · " & n & " projects in flight" & IF ( ISFILTERED ( DimProgramme[ProgrammeName] ) || ISFILTERED ( DimBusinessUnit[BusinessUnitName] ) || ISFILTERED ( DimProject[Priority] ), " (filtered)", "" )
		lineageTag: 5a1c0001-0000-4000-8000-000000000001

	measure 'Narr Schedule Cost' =
			VAR s = [SPI (as of)]
			VAR c = [CPI (as of)]
			VAR verdict = SWITCH ( TRUE (), s < 1 && c < 1, "behind plan and over cost", s >= 1 && c >= 1, "on or ahead of plan and within cost", s < 1, "behind plan, cost under control", "ahead of plan but over cost" )
			RETURN "SPI " & FORMAT ( s, "0.000" ) & " · CPI " & FORMAT ( c, "0.000" ) & ": " & verdict
		lineageTag: 5a1c0001-0000-4000-8000-000000000002

	measure 'Narr Forecast Cost' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			VAR fc = CALCULATE ( SUM ( FactProjectMonthly[ForecastTotalCostEUR] ), FactProjectMonthly[ReportingDateKey] = m )
			VAR bl = CALCULATE ( SUM ( FactProjectMonthly[BaselineBudgetEUR] ), FactProjectMonthly[ReportingDateKey] = m )
			RETURN "Forecast cost €" & FORMAT ( fc / 1000000, "0.0" ) & "M vs €" & FORMAT ( bl / 1000000, "0.0" ) & "M baseline (" & FORMAT ( DIVIDE ( fc, bl ) - 1, "+0.0%;-0.0%" ) & ")"
		lineageTag: 5a1c0001-0000-4000-8000-000000000003

	measure 'Narr Forecast Benefit' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			VAR fb = CALCULATE ( SUM ( FactProjectMonthly[ForecastBenefitEUR] ), FactProjectMonthly[ReportingDateKey] = m )
			VAR pb = CALCULATE ( SUM ( FactProjectMonthly[PlannedBenefitEUR] ), FactProjectMonthly[ReportingDateKey] = m )
			RETURN "Forecast benefits €" & FORMAT ( fb / 1000000, "0.0" ) & "M vs €" & FORMAT ( pb / 1000000, "0.0" ) & "M planned (" & FORMAT ( DIVIDE ( fb, pb ) - 1, "+0.0%;-0.0%" ) & ")"
		lineageTag: 5a1c0001-0000-4000-8000-000000000004

	measure 'Narr Decisions' = COALESCE ( CALCULATE ( [Projects (final)], DimProject[Recommended Action] = "Terminate" ), 0 ) & " terminate · " & COALESCE ( CALCULATE ( [Projects (final)], DimProject[Recommended Action] = "Pause" ), 0 ) & " pause · " & COALESCE ( CALCULATE ( [Projects (final)], DimProject[Recommended Action] IN { "Recover (high priority)", "Recover (monitor)" } ), 0 ) & " recover (" & COALESCE ( CALCULATE ( [Projects (final)], DimProject[Recommended Action] = "Recover (high priority)" ), 0 ) & " high priority) · " & COALESCE ( CALCULATE ( [Projects (final)], DimProject[Recommended Action] = "Accelerate" ), 0 ) & " accelerate · " & COALESCE ( CALCULATE ( [Projects (final)], DimProject[Recommended Action] = "Maintain" ), 0 ) & " maintain"
		lineageTag: 5a1c0001-0000-4000-8000-000000000005

	measure 'Narr Page2 Subtitle' = [Projects (final)] & " in-flight projects at their latest snapshot. Rules are proposals. Month filter does not apply to this page." & IF ( ISFILTERED ( DimProgramme[ProgrammeName] ) || ISFILTERED ( DimProject[Priority] ) || ISFILTERED ( DimProject[Recommended Action] ), " (filtered)", "" )
		lineageTag: 5a1c0001-0000-4000-8000-000000000006

	measure 'Avg Risk Exposure (as of)' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			RETURN CALCULATE ( AVERAGE ( FactProjectMonthly[RiskExposureScore] ), FactProjectMonthly[ReportingDateKey] = m )
		formatString: 0.0
		lineageTag: 5a1c0002-0000-4000-8000-000000000001

	measure 'Overdue Mitigations (as of)' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			RETURN CALCULATE ( SUM ( FactProjectMonthly[OverdueMitigationActions] ), FactProjectMonthly[ReportingDateKey] = m )
		formatString: 0
		lineageTag: 5a1c0002-0000-4000-8000-000000000002

	measure 'Critical Risks (as of)' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			RETURN CALCULATE ( SUM ( FactProjectMonthly[CriticalRisks] ), FactProjectMonthly[ReportingDateKey] = m )
		formatString: 0
		lineageTag: 5a1c0002-0000-4000-8000-000000000003

	measure 'Narr Header Context' =
			VAR m = MAX ( FactProjectMonthly[ReportingDateKey] )
			VAR d = LOOKUPVALUE ( DimDate[Date], DimDate[DateKey], m )
			RETURN "Month-end snapshot: " & FORMAT ( d, "mmm yyyy" ) & IF ( ISFILTERED ( DimProgramme[ProgrammeName] ) || ISFILTERED ( DimBusinessUnit[BusinessUnitName] ) || ISFILTERED ( DimProject[Priority] ), " · filters applied", " · all programmes" ) & ". Cards and donut follow the month filter."
		lineageTag: 5a1c0004-0000-4000-8000-000000000001

	column Col1
		dataType: int64
		isHidden
		lineageTag: 994fa9e2-31ac-4e69-a016-3b1850f83993
		summarizeBy: none
		sourceColumn: Col1

	partition _Measures = m
		mode: import
		source =
				let
				  Source = #table(type table [Col1 = Int64.Type], {})
				in
				  Source

